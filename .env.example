# ------------------------------
# App
# ------------------------------
APP_NAME=AI Attendance System
APP_ENV=development
DEBUG=True

# ------------------------------
# Database (PostgreSQL + pgvector)
# ------------------------------
POSTGRES_USER=aias_user
POSTGRES_PASSWORD=aias123
POSTGRES_DB=attendance_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://attendance_user:change_me@db:5432/attendance_db

# ------------------------------
# JWT Auth
# ------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------
# Celery / Redis (async face recognition jobs)
# ------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------
# Object Storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2)
# ------------------------------
STORAGE_PROVIDER=r2
STORAGE_BUCKET_NAME=attendance-photos
STORAGE_ACCESS_KEY_ID=replace_me
STORAGE_SECRET_ACCESS_KEY=replace_me
STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto

# ------------------------------
# Face Recognition
# ------------------------------
FACE_MATCH_THRESHOLD=0.45
FACE_EMBEDDING_MODEL=buffalo_l
MIN_REGISTRATION_IMAGES=15
MAX_REGISTRATION_IMAGES=30

# ------------------------------
# CORS
# ------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5174

# ------------------------------
# Frontend
# ------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
